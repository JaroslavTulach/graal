<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.apidesign.demo</groupId>
    <artifactId>syslog</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <exec.mainClass>org.apidesign.demo.syslog.SysLog</exec.mainClass>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>nativeimage</artifactId>
            <version>25.0.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <profiles>
        <profile>
            <!--
            Run as regular classpath Java application. Invoke as:

            mvn -Pclasspath package exec:exec
            -->
            <id>classpath</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <arg>-cp</arg>
                                <classpath/>
                                <arg>${exec.mainClass}</arg>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!--
            Run as module Java application. Invoke as:

            JAVA_HOME=/graalvm-community-openjdk-25+25.1/ mvn -Pmodulepath package exec:exec
            -->
            <id>modulepath</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <arg>-p</arg>
                                <modulepath/>
                                <arg>-m</arg>
                                <arg>org.apidesign.demo.syslog/${exec.mainClass}</arg>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!--
            Run as module Java application. Invoke as:

            JAVA_HOME=/graalvm-community-openjdk-25+25.1/ mvn -Plimitmodules package exec:exec
            -->
            <id>limitmodules</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <arg>--limit-modules</arg>
                                <arg>java.base</arg>
                                <arg>-p</arg>
                                <modulepath/>
                                <arg>-m</arg>
                                <arg>org.apidesign.demo.syslog/${exec.mainClass}</arg>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!--
            Run as native Java application compiled in "module-path" mode. Invoke as:

            JAVA_HOME=/graalvm-community-openjdk-25+25.1/ mvn -Pnative package exec:exec@syslog
            -->
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <executions>
                            <execution>
                                <id>native</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/native-image</executable>
                                    <arguments>
                                        <arg>--initialize-at-build-time</arg>
                                        <arg>org.apidesign.demo.syslog</arg>
                                        <arg>--features=org.apidesign.demo.syslog.SysLogFeature</arg>
                                        <arg>-g</arg>
                                        <arg>-Ob</arg>
                                        <arg>-o</arg>
                                        <arg>${project.build.directory}/syslog</arg>
                                        <arg>-p</arg>
                                        <classpath/>
                                        <arg>-m</arg>
                                        <arg>org.apidesign.demo.syslog/${exec.mainClass}</arg>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>syslog</id>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${project.build.directory}/syslog</executable>
                                    <arguments>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>                        
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>