<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.apidesign.demo</groupId>
    <artifactId>syslog</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <exec.mainClass>org.apidesign.demo.syslog.SysLog</exec.mainClass>
    </properties>
    <dependencies>
    </dependencies>
    <profiles>
        <profile>
            <!--
            Run as regular classpath Java application. Invoke as:

            mvn -Pclasspath package exec:exec
            -->
            <id>classpath</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <arg>-cp</arg>
                                <classpath/>
                                <arg>${exec.mainClass}</arg>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!--
            Profile as module Java application. Invoke as:

            JAVA_HOME=/graalvm-community-openjdk-25+25.1/ mvn -Pmodulepath package exec:exec
            -->
            <id>modulepath</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <arg>-p</arg>
                                <modulepath/>
                                <arg>-m</arg>
                                <arg>org.apidesign.demo.syslog/${exec.mainClass}</arg>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!--
            Profile as module Java application. Invoke as:

            JAVA_HOME=/graalvm-community-openjdk-25+25.1/ mvn -Plimitmodules package exec:exec
            -->
            <id>limitmodules</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <arg>--limit-modules</arg>
                                <arg>java.base</arg>
                                <arg>-p</arg>
                                <modulepath/>
                                <arg>-m</arg>
                                <arg>org.apidesign.demo.syslog/${exec.mainClass}</arg>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.11.3</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <mainClass>${exec.mainClass}</mainClass>
                            <buildArgs>
                                <arg>-Ob</arg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <executable>target/syslog</executable>
                            <arguments>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>